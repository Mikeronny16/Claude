{
  "name": "1 — Clinic Booking Bot (Telegram)",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "id": "tg-0001-0001-0001-0001-000000000001",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "clinic-bot-webhook",
      "credentials": { "telegramApi": { "id": "YOUR_TELEGRAM_CRED_ID", "name": "Telegram Bot" } }
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json;\n\nconst msg = body.message || body.edited_message;\nif (!msg) return [{ json: { skip: true } }];\n\nconst senderId = String(msg.chat.id);\nconst senderName = msg.from?.first_name || 'Patient';\nconst messageText = (msg.text || '').trim();\nconst normalizedText = messageText.toLowerCase();\n\nreturn [{\n  json: {\n    senderId,\n    senderName,\n    messageText,\n    normalizedText,\n    platform: 'telegram'\n  }\n}];"
      },
      "id": "tg-0002-0002-0002-0002-000000000002",
      "name": "Parse Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [{ "leftValue": "={{ $json.skip }}", "rightValue": true, "operator": { "type": "boolean", "operation": "notEquals" } }],
          "combinator": "and"
        }
      },
      "id": "tg-0003-0003-0003-0003-000000000003",
      "name": "Valid Message?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": { "mode": "id", "value": "YOUR_GOOGLE_SHEET_ID_HERE" },
        "sheetName": { "mode": "name", "value": "Sessions" },
        "filtersUI": {
          "values": [{ "lookupColumn": "sender_id", "lookupValue": "={{ $('Parse Message').first().json.senderId }}" }]
        },
        "options": { "returnFirstMatch": true }
      },
      "id": "tg-0004-0004-0004-0004-000000000004",
      "name": "Load Session",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [900, 240],
      "credentials": { "googleSheetsOAuth2Api": { "id": "YOUR_GOOGLE_CRED_ID", "name": "Google Sheets" } }
    },
    {
      "parameters": {
        "jsCode": "const msg = $('Parse Message').first().json;\nconst rows = $input.all();\n\nlet state = 'new';\nlet tempSlots = '';\nlet reason = '';\nlet selectedSlot = '';\nlet patientName = msg.senderName;\n\nif (rows.length > 0 && rows[0].json.sender_id) {\n  const s = rows[0].json;\n  state = s.state || 'new';\n  tempSlots = s.temp_slots || '';\n  reason = s.reason || '';\n  selectedSlot = s.selected_slot || '';\n  patientName = s.patient_name || msg.senderName;\n}\n\n// Reset keywords\nconst resetWords = ['start', 'restart', 'ပြန်', 'cancel', 'reset'];\nif (resetWords.some(w => msg.normalizedText.includes(w))) {\n  state = 'new';\n}\n\nreturn [{ json: { ...msg, state, tempSlots, reason, selectedSlot, patientName } }];"
      },
      "id": "tg-0005-0005-0005-0005-000000000005",
      "name": "Merge Session",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 240]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.state }}", "rightValue": "new", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "new" },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.state }}", "rightValue": "awaiting_reason", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "awaiting_reason" },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.state }}", "rightValue": "awaiting_slot", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "awaiting_slot" },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.state }}", "rightValue": "awaiting_name", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "awaiting_name" }
          ]
        },
        "fallbackOutput": "extra"
      },
      "id": "tg-0006-0006-0006-0006-000000000006",
      "name": "Route by State",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1340, 240]
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nreturn [{ json: { ...d,\n  replyText: `မင်္ဂလာပါ! 🏥 ClinicAI Myanmar မှ ကြိုဆိုပါတယ်\\n\\nAppointment ယူဖို့ ကူညီပေးပါမယ်။\\n\\nဆရာဝန်ဆီ လာရတဲ့ အကြောင်းအရင်းကို ပြောပြပါ\\n(ဥပမာ: ချမ်းတက်တယ်, ဆေးစစ်ချင်တယ်, မျက်စိနာတယ်)`,\n  newState: 'awaiting_reason'\n} }];"
      },
      "id": "tg-0007-0007-0007-0007-000000000007",
      "name": "Handle: New",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 60]
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst reason = d.messageText;\n\nconst today = new Date();\nconst tmr = new Date(today); tmr.setDate(today.getDate()+1);\nconst d2 = new Date(today); d2.setDate(today.getDate()+2);\nconst fmt = x => `${x.getDate()}/${x.getMonth()+1}`;\n\nconst slots = [\n  { key: '1', label: `မနက်ဖြန် ${fmt(tmr)} — 9:00 AM`, datetime: tmr.toISOString().split('T')[0]+'T09:00:00' },\n  { key: '2', label: `မနက်ဖြန် ${fmt(tmr)} — 11:00 AM`, datetime: tmr.toISOString().split('T')[0]+'T11:00:00' },\n  { key: '3', label: `မနက်ဖြန် ${fmt(tmr)} — 3:00 PM`, datetime: tmr.toISOString().split('T')[0]+'T15:00:00' },\n  { key: '4', label: `${fmt(d2)} — 9:00 AM`, datetime: d2.toISOString().split('T')[0]+'T09:00:00' },\n  { key: '5', label: `${fmt(d2)} — 2:00 PM`, datetime: d2.toISOString().split('T')[0]+'T14:00:00' },\n];\n\nconst slotText = slots.map(s => `${s.key}️⃣  ${s.label}`).join('\\n');\n\nreturn [{ json: { ...d, reason, tempSlots: JSON.stringify(slots),\n  replyText: `ကောင်းပါတယ်! \"${reason}\" အတွက် slot ရွေးပါ:\\n\\n${slotText}\\n\\nနံပါတ် (1-5) ပို့ပါ`,\n  newState: 'awaiting_slot'\n} }];"
      },
      "id": "tg-0008-0008-0008-0008-000000000008",
      "name": "Handle: Got Reason",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 200]
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst input = d.messageText.trim();\nlet slots = [];\ntry { slots = JSON.parse(d.tempSlots || '[]'); } catch(e) {}\n\nconst chosen = slots.find(s => input === s.key || input.startsWith(s.key));\n\nif (!chosen) {\n  return [{ json: { ...d,\n    replyText: `နံပါတ် 1 မှ ${slots.length} အတွင်း ရွေးပါ\\n(ဥပမာ: \"1\" ဆိုပြီး ပို့ပါ)`,\n    newState: 'awaiting_slot'\n  } }];\n}\n\nreturn [{ json: { ...d,\n  selectedSlot: chosen.label,\n  selectedDatetime: chosen.datetime,\n  replyText: `${chosen.label} ကို ရွေးပါပြီ ✅\\n\\nနောက်ဆုံး — မင်းနာမည် ပြောပြပါ`,\n  newState: 'awaiting_name'\n} }];"
      },
      "id": "tg-0009-0009-0009-0009-000000000009",
      "name": "Handle: Got Slot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 340]
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst patientName = d.messageText.trim();\n\nreturn [{ json: { ...d, patientName,\n  replyText: `✅ Appointment Confirm ပါပြီ!\\n\\n👤 Patient: ${patientName}\\n📅 Slot: ${d.selectedSlot}\\n💊 ကြောင်းရင်း: ${d.reason}\\n\\n🔔 Reminder ကို 1 နာရီ အလိုမှာ auto-ပို့ပေးပါမယ်\\n\\nမေးစရာရှိရင် ဒီ bot ကိုပဲ message ပို့ပါ 🏥`,\n  newState: 'confirmed',\n  saveBooking: true\n} }];"
      },
      "id": "tg-0010-0010-0010-0010-000000000010",
      "name": "Handle: Got Name",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 480]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "mode": "id", "value": "YOUR_GOOGLE_SHEET_ID_HERE" },
        "sheetName": { "mode": "name", "value": "Sessions" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "sender_id": "={{ $json.senderId }}",
            "platform": "telegram",
            "state": "={{ $json.newState }}",
            "reason": "={{ $json.reason || '' }}",
            "temp_slots": "={{ $json.tempSlots || '' }}",
            "selected_slot": "={{ $json.selectedSlot || '' }}",
            "selected_datetime": "={{ $json.selectedDatetime || '' }}",
            "patient_name": "={{ $json.patientName || '' }}",
            "last_updated": "={{ $now.toISO() }}"
          },
          "matchingColumns": ["sender_id"],
          "schema": []
        },
        "options": {}
      },
      "id": "tg-0011-0011-0011-0011-000000000011",
      "name": "Save Session",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [1800, 260],
      "credentials": { "googleSheetsOAuth2Api": { "id": "YOUR_GOOGLE_CRED_ID", "name": "Google Sheets" } }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "mode": "id", "value": "YOUR_GOOGLE_SHEET_ID_HERE" },
        "sheetName": { "mode": "name", "value": "Appointments" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "patient_name": "={{ $json.patientName }}",
            "sender_id": "={{ $json.senderId }}",
            "platform": "telegram",
            "reason": "={{ $json.reason }}",
            "slot": "={{ $json.selectedSlot }}",
            "appointment_datetime": "={{ $json.selectedDatetime }}",
            "status": "confirmed",
            "reminder_24h_sent": "FALSE",
            "reminder_2h_sent": "FALSE",
            "review_sent": "FALSE",
            "booked_at": "={{ $now.toISO() }}"
          },
          "schema": []
        },
        "options": {}
      },
      "id": "tg-0012-0012-0012-0012-000000000012",
      "name": "Save Appointment",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [1800, 480],
      "credentials": { "googleSheetsOAuth2Api": { "id": "YOUR_GOOGLE_CRED_ID", "name": "Google Sheets" } }
    },
    {
      "parameters": {
        "chatId": "={{ $('Parse Message').first().json.senderId }}",
        "text": "={{ $json.replyText }}",
        "additionalFields": { "parse_mode": "HTML" }
      },
      "id": "tg-0013-0013-0013-0013-000000000013",
      "name": "Send Telegram Reply",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2040, 340],
      "credentials": { "telegramApi": { "id": "YOUR_TELEGRAM_CRED_ID", "name": "Telegram Bot" } }
    }
  ],
  "connections": {
    "Telegram Trigger": { "main": [[{ "node": "Parse Message", "type": "main", "index": 0 }]] },
    "Parse Message": { "main": [[{ "node": "Valid Message?", "type": "main", "index": 0 }]] },
    "Valid Message?": { "main": [[{ "node": "Load Session", "type": "main", "index": 0 }], []] },
    "Load Session": { "main": [[{ "node": "Merge Session", "type": "main", "index": 0 }]] },
    "Merge Session": { "main": [[{ "node": "Route by State", "type": "main", "index": 0 }]] },
    "Route by State": {
      "main": [
        [{ "node": "Handle: New", "type": "main", "index": 0 }],
        [{ "node": "Handle: Got Reason", "type": "main", "index": 0 }],
        [{ "node": "Handle: Got Slot", "type": "main", "index": 0 }],
        [{ "node": "Handle: Got Name", "type": "main", "index": 0 }]
      ]
    },
    "Handle: New": { "main": [[{ "node": "Save Session", "type": "main", "index": 0 }]] },
    "Handle: Got Reason": { "main": [[{ "node": "Save Session", "type": "main", "index": 0 }]] },
    "Handle: Got Slot": { "main": [[{ "node": "Save Session", "type": "main", "index": 0 }]] },
    "Handle: Got Name": {
      "main": [[{ "node": "Save Appointment", "type": "main", "index": 0 }]]
    },
    "Save Session": { "main": [[{ "node": "Send Telegram Reply", "type": "main", "index": 0 }]] },
    "Save Appointment": { "main": [[{ "node": "Send Telegram Reply", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "clinic-ai-telegram" }],
  "_readme": {
    "setup": [
      "1. Telegram မှာ @BotFather ကို message ပို့ → /newbot → token ယူ",
      "2. n8n မှာ Telegram credential add (token paste)",
      "3. YOUR_GOOGLE_SHEET_ID_HERE → Mike ရဲ့ Sheet ID",
      "4. Google Sheets credential connect (OAuth2)",
      "5. Workflow activate → bot ကို /start ပို့ပြီး test"
    ]
  }
}
