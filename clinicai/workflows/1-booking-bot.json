  "tags": [{ "name": "clinic-ai", "createdAt": "2026-01-01T00:00:00.000Z" }],
  "_readme": {
    "description": "ClinicAI Myanmar — Booking Bot Workflow",
    "setup_steps": [
      "1. YOUR_GOOGLE_SHEET_ID_HERE ကို actual Google Sheet ID နဲ့ ပြောင်းပါ",
      "2. YOUR_VIBER_BOT_TOKEN_HERE ကို Viber Business account token နဲ့ ပြောင်းပါ",
      "3. YOUR_PAGE_ACCESS_TOKEN_HERE ကို Facebook Page token နဲ့ ပြောင်းပါ",
      "4. Google Sheets မှာ 'Sessions' sheet နဲ့ 'Appointments' sheet ဆောက်ပါ",
      "5. Webhook URL ကို Viber webhook URL မှာ set လုပ်ပါ",
      "6. Workflow activate လုပ်ပါ"
    ],
    "google_sheets_sessions_columns": ["sender_id", "platform", "state", "reason", "temp_slots", "selected_slot", "patient_name", "last_updated"],
    "google_sheets_appointments_columns": ["patient_name", "sender_id", "platform", "reason", "slot", "status", "reminder_24h_sent", "reminder_2h_sent", "review_sent", "booked_at"]
  }
}
