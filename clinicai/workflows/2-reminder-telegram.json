{
  "name": "2 — Clinic Reminders (Telegram, 24h + 2h)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 1 }] }
      },
      "id": "rm-0001-0001-0001-0001-000000000001",
      "name": "Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": { "mode": "id", "value": "YOUR_GOOGLE_SHEET_ID_HERE" },
        "sheetName": { "mode": "name", "value": "Appointments" },
        "filtersUI": { "values": [{ "lookupColumn": "status", "lookupValue": "confirmed" }] },
        "options": {}
      },
      "id": "rm-0002-0002-0002-0002-000000000002",
      "name": "Get Appointments",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [460, 300],
      "credentials": { "googleSheetsOAuth2Api": { "id": "YOUR_GOOGLE_CRED_ID", "name": "Google Sheets" } }
    },
    {
      "parameters": {
        "jsCode": "const appointments = $input.all();\nconst now = new Date();\nconst toSend = [];\n\nfor (const item of appointments) {\n  const a = item.json;\n  if (!a.appointment_datetime || !a.sender_id) continue;\n\n  const apptTime = new Date(a.appointment_datetime);\n  const hoursUntil = (apptTime - now) / (1000 * 60 * 60);\n\n  if (hoursUntil >= 23 && hoursUntil <= 25 && a.reminder_24h_sent === 'FALSE') {\n    toSend.push({ json: { ...a, reminderType: '24h' } });\n  } else if (hoursUntil >= 1.5 && hoursUntil <= 2.5 && a.reminder_2h_sent === 'FALSE') {\n    toSend.push({ json: { ...a, reminderType: '2h' } });\n  }\n}\n\nreturn toSend.length > 0 ? toSend : [{ json: { skip: true } }];"
      },
      "id": "rm-0003-0003-0003-0003-000000000003",
      "name": "Find Due Reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [{ "leftValue": "={{ $json.skip }}", "rightValue": true, "operator": { "type": "boolean", "operation": "notEquals" } }],
          "combinator": "and"
        }
      },
      "id": "rm-0004-0004-0004-0004-000000000004",
      "name": "Has Reminders?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst is24h = d.reminderType === '24h';\n\nconst msg24h = `🔔 Appointment Reminder!\\n\\nမနက်ဖြန် appointment ရှိပါတယ် 📅\\n\\n👤 ${d.patient_name}\\n🕘 ${d.slot}\\n💊 ${d.reason}\\n\\nLate ဖြစ်ပါက ဒီ bot ကိုပဲ ကြိုပြောပေးပါ`;\n\nconst msg2h = `⏰ 2 နာရီ အတွင်း Appointment ရှိပါတယ်!\\n\\n👤 ${d.patient_name}\\n🕘 ${d.slot}\\n\\nအချိန်မီ ကြွပါ 🏥`;\n\nreturn [{ json: { ...d, replyText: is24h ? msg24h : msg2h } }];"
      },
      "id": "rm-0005-0005-0005-0005-000000000005",
      "name": "Build Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 220]
    },
    {
      "parameters": {
        "chatId": "={{ $json.sender_id }}",
        "text": "={{ $json.replyText }}",
        "additionalFields": {}
      },
      "id": "rm-0006-0006-0006-0006-000000000006",
      "name": "Send Telegram Reminder",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1340, 220],
      "credentials": { "telegramApi": { "id": "YOUR_TELEGRAM_CRED_ID", "name": "Telegram Bot" } }
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": { "mode": "id", "value": "YOUR_GOOGLE_SHEET_ID_HERE" },
        "sheetName": { "mode": "name", "value": "Appointments" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "reminder_24h_sent": "={{ $('Find Due Reminders').first().json.reminderType === '24h' ? 'TRUE' : $json.reminder_24h_sent }}",
            "reminder_2h_sent": "={{ $('Find Due Reminders').first().json.reminderType === '2h' ? 'TRUE' : $json.reminder_2h_sent }}"
          },
          "matchingColumns": ["sender_id"],
          "schema": []
        },
        "options": {}
      },
      "id": "rm-0007-0007-0007-0007-000000000007",
      "name": "Mark Sent",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [1560, 220],
      "credentials": { "googleSheetsOAuth2Api": { "id": "YOUR_GOOGLE_CRED_ID", "name": "Google Sheets" } }
    }
  ],
  "connections": {
    "Every Hour": { "main": [[{ "node": "Get Appointments", "type": "main", "index": 0 }]] },
    "Get Appointments": { "main": [[{ "node": "Find Due Reminders", "type": "main", "index": 0 }]] },
    "Find Due Reminders": { "main": [[{ "node": "Has Reminders?", "type": "main", "index": 0 }]] },
    "Has Reminders?": { "main": [[{ "node": "Build Message", "type": "main", "index": 0 }], []] },
    "Build Message": { "main": [[{ "node": "Send Telegram Reminder", "type": "main", "index": 0 }]] },
    "Send Telegram Reminder": { "main": [[{ "node": "Mark Sent", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "clinic-ai-telegram" }]
}
