{
  "name": "Readyuse — Lead Gen + CRM",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "readyuse-lead-capture",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "c1d2e3f4-0001-0001-0001-000000000001",
      "name": "Webhook — Receive Lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "readyuse-lead-gen-01"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json.body || $input.first().json;\nreturn [{ json: { name: data.name || data.Name || 'Friend', email: data.email || data.Email || '', phone: data.phone || data.Phone || '', source: data.source || 'Website', date: new Date().toISOString() } }];"
      },
      "id": "c1d2e3f4-0002-0002-0002-000000000002",
      "name": "Extract Lead Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "mode": "id", "value": "YOUR_GOOGLE_SHEET_ID" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Leads" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Name": "={{ $json.name }}",
            "Email": "={{ $json.email }}",
            "Phone": "={{ $json.phone }}",
            "Source": "={{ $json.source }}",
            "Date": "={{ $json.date }}",
            "Status": "New"
          }
        }
      },
      "id": "c1d2e3f4-0003-0003-0003-000000000003",
      "name": "Save to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [680, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets — your account"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "YOUR_GMAIL@gmail.com",
        "toEmail": "={{ $('Extract Lead Data').item.json.email }}",
        "subject": "Thanks for reaching out, {{ $('Extract Lead Data').item.json.name }}!",
        "emailType": "html",
        "message": "<h2>Hi {{ $('Extract Lead Data').item.json.name }},</h2><p>Thank you for your interest! We've received your details and will get back to you within 24 hours.</p><p>Best regards,<br/>Your Team</p>"
      },
      "id": "c1d2e3f4-0004-0004-0004-000000000004",
      "name": "Send Welcome Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [680, 480],
      "credentials": {
        "gmailOAuth2": {
          "id": "GMAIL_CREDENTIAL_ID",
          "name": "Gmail — sign in with Google"
        }
      }
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "🎯 New Lead!\n\n👤 Name: {{ $('Extract Lead Data').item.json.name }}\n📧 Email: {{ $('Extract Lead Data').item.json.email }}\n📱 Phone: {{ $('Extract Lead Data').item.json.phone }}\n🌐 Source: {{ $('Extract Lead Data').item.json.source }}",
        "additionalFields": {}
      },
      "id": "c1d2e3f4-0005-0005-0005-000000000005",
      "name": "Telegram — Notify Mike",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [680, 140],
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram Bot — your bot token"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"success\": true, \"message\": \"Thank you! We'll be in touch soon.\" }"
      },
      "id": "c1d2e3f4-0006-0006-0006-000000000006",
      "name": "Respond to Form",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Webhook — Receive Lead": {
      "main": [[{ "node": "Extract Lead Data", "type": "main", "index": 0 }]]
    },
    "Extract Lead Data": {
      "main": [[
        { "node": "Save to Google Sheets", "type": "main", "index": 0 },
        { "node": "Send Welcome Email", "type": "main", "index": 0 },
        { "node": "Telegram — Notify Mike", "type": "main", "index": 0 }
      ]]
    },
    "Save to Google Sheets": {
      "main": [[{ "node": "Respond to Form", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "instanceId": "readyuse-template-v1" },
  "_readme": "READYUSE TEMPLATE — Lead Gen + CRM (n8n). Replace YOUR_GOOGLE_SHEET_ID, YOUR_GMAIL, YOUR_TELEGRAM_CHAT_ID. Connect Google Sheets, Gmail OAuth2, and Telegram credentials. Webhook URL: copy from the Webhook node after activating."
}
